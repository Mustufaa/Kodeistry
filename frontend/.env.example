# Kody uses this API URL. Keep GEMINI_API_KEY on the backend only.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Public SEO values: set before building; rebuild after changes.
SITE_URL=https://kodeistry.onrender.com
# Optional overrides. The existing user-provided Google token is retained by default.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
