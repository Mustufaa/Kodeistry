# Backend configuration. Keep this file private and do not commit real values.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kodeistry
DATABASE_ECHO=false

# Generate a random value with at least 32 bytes of entropy.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_NAME=kodeistry_session
CSRF_COOKIE_NAME=kodeistry_csrf
# For separate HTTPS frontend/backend sites, set Secure=true and SameSite=none.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=Kodeistry <no-reply@example.com>
MAIL_PORT=587
MAIL_SERVER=smtp.example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# GitHub OAuth app. OAuth only identifies the user; repository access uses the GitHub App.
GITHUB_CLIENT_ID=your-oauth-client-id
GITHUB_CLIENT_SECRET=your-oauth-client-secret
BACKEND_URL=http://localhost:8000
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# GitHub App.
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_SLUG=kodeistry
# Choose one private-key form. A path is easiest for local development.
GITHUB_PRIVATE_KEY_PATH=secrets/kodeistry-app.pem
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret

FRONTEND_URL=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

