FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
RUN useradd --system --create-home --uid 10002 fixworker
USER fixworker

# Deploy separately from the API, sharing PostgreSQL and GitHub App configuration.
CMD ["python", "-m", "app.services.fix_worker"]
